# LOCAL DEVELOPMENT ONLY: replace this with a generated secret before deployment.
# Generate a token with: python -c "import secrets; print(secrets.token_urlsafe(40))"
ADMIN_TOKEN=burger-haven-local-demo-token-change-before-deployment-2026
# Optional lower-privilege operational token. Staff can manage orders/menu but cannot access analytics.
# Leave blank to allow ADMIN_TOKEN for all staff dashboard operations.
STAFF_TOKEN=
# Per-person access: give registered accounts the staff/admin role with `python manage_users.py set-role EMAIL staff|admin`.
# Account roles and these shared tokens can be used side by side.

# Local SQLite database file. In Docker, set this to /data/burger_haven.db.
DATABASE_PATH=./burger_haven.db
UPLOAD_DIR=./uploads
HOST=127.0.0.1
PORT=8000
RELOAD=false

# MANUAL WALLET PAYMENTS ONLY — no GCash/Maya API or payment gateway.
# Enter your own official merchant/account name and receiving mobile number below.
# Customers will see these values and the exact server-calculated order total at checkout.
# Leave them blank until you are ready; GCash/Maya will remain unavailable until both
# the account name AND mobile number for that wallet are filled in. Restart the app after edits.
# Never put wallet PINs, passwords, or OTPs here.
GCASH_ACCOUNT_NAME=
GCASH_NUMBER=
# Optional: if you add a merchant QR image inside static/, set e.g. /static/gcash-qr.png
GCASH_QR_IMAGE=
MAYA_ACCOUNT_NAME=
MAYA_NUMBER=
# Optional: if you add a merchant QR image inside static/, set e.g. /static/maya-qr.png
MAYA_QR_IMAGE=

# Business settings (amounts in Philippine pesos)
CASH_ENABLED=true
CASH_ON_DELIVERY=true
CASH_ON_PICKUP=true
DELIVERY_FEE_PHP=30
MINIMUM_ORDER_PHP=0
